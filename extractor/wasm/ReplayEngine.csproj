<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>ReplayEngine</AssemblyName>
    <RootNamespace>ReplayEngine</RootNamespace>
    <WasmDebugLevel>0</WasmDebugLevel>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>false</UseSystemResourceKeys>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <RunAOTCompilation>true</RunAOTCompilation>
    <CompressionEnabled>false</CompressionEnabled>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../*.cs" Exclude="../Program.cs;../Verify.cs" />
    <ProjectReference Include="../../vendor/FortniteReplayDecompressor/src/FortniteReplayReader/FortniteReplayReader.csproj" />
    <TrimmerRootAssembly Include="Unreal.Core" />
    <TrimmerRootAssembly Include="FortniteReplayReader" />
  </ItemGroup>
</Project>
