{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd web && npm ci --no-audit --no-fund",
  "buildCommand": "cd web && npx vite build --mode hosted && npx tsx site/build.ts",
  "outputDirectory": "web/dist-hosted",
  "redirects": [
    {
      "source": "/app",
      "destination": "/app/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/app/((?!assets/|engine/|map/).*)",
      "destination": "/app/index.html"
    }
  ],
  "headers": [
    {
      "source": "/site-assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app/engine/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
